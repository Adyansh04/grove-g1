<?xml version="1.0"?>
<!--
  Pick the block up, hold it, put it down beside where it was. No navigation.

  This is the tree to run against the `manipulation` world, where the object is already at
  arm's length and there is nowhere to drive to. pick_and_place.xml is the full mission and
  needs Nav2, the facility world and a map; this one needs none of that, so it is what makes
  the orchestration layer (and Groot2) testable while the manipulation work is being tuned.

  Coordinates are odom, which is the frame /objects publishes in. The place target is 6 cm to
  the robot's left of where the block starts, on the same table top.

  Assumes the arm is already acquired, which activate_arm:=true does. AcquireArm is here
  anyway: it is idempotent, and a tree that only works when something else happened first is a
  tree that fails confusingly.
-->
<root BTCPP_format="4" main_tree_to_execute="PickAndPlaceInPlace">
  <BehaviorTree ID="PickAndPlaceInPlace">
    <Sequence name="pick_and_put_down">
      <AcquireArm name="take_the_arm"/>

      <RetryUntilSuccessful name="pick_with_one_retry" num_attempts="2">
        <Pick name="pick_the_block" object_id="red_block" arm="right"/>
      </RetryUntilSuccessful>

      <SetArmPosture name="hold_it_close" group="right_arm" named_target="carry"/>

      <!-- On the pedestal, which is narrower than it looks from here: its near edge is at
           x 0.26 and the block is 60 mm across, so anything under x 0.29 hangs over the edge and
           falls. 0.845 is where a 90 mm block's centre sits on the 0.80 top. -->
      <Place name="put_it_down" target="0.31;-0.17;0.845" frame_id="odom" arm="right"/>

      <SetArmPosture name="tuck_away" group="right_arm" named_target="tucked"/>
      <ReleaseArm name="hand_the_arm_back"/>
    </Sequence>
  </BehaviorTree>
</root>
