<?xml version="1.0"?>
<!--
  Grasp the block with a learned policy instead of a planned pick, then hold it close at carry. No
  navigation; same world as pick_and_place_in_place.xml, so the two grasps compare directly.

  The retry resamples the policy's stochastic action head. A failed Grasp leaves the arm where
  it stopped. The tree ends holding the block, so the arms are kept: tucking would drive it into
  the body, and a released hand would drop it.
-->
<root BTCPP_format="4" main_tree_to_execute="VlaGraspInPlace">
  <BehaviorTree ID="VlaGraspInPlace">
    <Sequence name="grasp_and_hold">
      <AcquireArm name="take_the_arm"/>

      <RetryUntilSuccessful name="grasp_with_one_retry" num_attempts="2">
        <Grasp name="grasp_the_block" instruction="pick up the red block" object_id="red_block"
               arm="right"/>
      </RetryUntilSuccessful>

      <SetArmPosture name="hold_it_close" group="right_arm" named_target="carry"/>
    </Sequence>
  </BehaviorTree>
</root>
