<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_bringup</name>
  <version>0.1.0</version>
  <description>
    Sim bring-up for the G1 stack: launches unitree_mujoco alongside the ros2_control stack.
    Launch files, config, scenes and scripts only, with no compiled code of its own. See README
    for the full operating procedure.
  </description>
  <maintainer email="gupta.adyansh@gmail.com">Adyansh</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>g1_description</depend>
  <depend>g1_state_estimation</depend>
  <depend>g1_sensor_relay</depend>
  <depend>robot_state_publisher</depend>
  <depend>controller_manager</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>imu_sensor_broadcaster</depend>
  <depend>forward_command_controller</depend>
  <depend>g1_controllers</depend>
  <depend>joint_trajectory_controller</depend>
  <depend>xacro</depend>
  <depend>controller_manager_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>rclpy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xvfb</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Loaded at runtime by control.launch.py as a ros2_control plugin; nothing here
       compiles against it. -->
  <exec_depend>g1_hardware_interface</exec_depend>
  <exec_depend>g1_hand_interface</exec_depend>

  <!-- Manual teleop demo dependency (see README). -->
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <!-- Lint checks run via workspace-root CTests (see CMakeLists.txt). -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <!-- The launch suites are Python and import these directly. -->
  <test_depend>nav_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>control_msgs</test_depend>
  <test_depend>trajectory_msgs</test_depend>
  <test_depend>builtin_interfaces</test_depend>
  <test_depend>geometry_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
