# canopy's canopy.rviz with the G1's chest camera added; keep the two in step.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /World model1
    Splitter Ratio: 0.55
  Tree Height: 560
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Name: root
  Displays:
  - Class: rviz_default_plugins/Map
    Name: Map as SLAM builds it
    Enabled: false
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Alpha: 0.9
    Color Scheme: map
    Draw Behind: true
  - Class: rviz_default_plugins/Map
    Name: Floor plan (walls closed, furniture solid)
    Enabled: true
    Topic:
      Value: /canopy/floor_plan
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Alpha: 0.9
    Color Scheme: map
    Draw Behind: true
  - Class: rviz_common/Group
    Name: World model
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/Map
      Name: Camera coverage (red = still to see, cyan = written off)
      Enabled: true
      Topic:
        Value: /canopy/coverage
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: false
    - Class: rviz_default_plugins/Map
      Name: Walls the rooms are cut on
      Enabled: false
      Topic:
        Value: /canopy/walls
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Rooms, objects, next viewpoint
      Enabled: true
      Namespaces:
        room_areas: true
        room_outlines: true
        room_names: true
        doorways: true
        objects: true
        object_names: true
        viewpoint: true
        visited: true
        visit_numbers: true
        glimpses: true
        camera_view: true
      Topic:
        Value: /canopy/markers
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  - Class: rviz_default_plugins/RobotModel
    Name: Robot
    Enabled: true
    Description Topic:
      Value: /robot_description
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Alpha: 1
  - Class: rviz_default_plugins/Path
    Name: Robot's trail
    Enabled: true
    Topic:
      Value: /canopy/trail
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
    Color: 80; 200; 255
    Line Style: Lines
    Line Width: 0.03
  - Class: rviz_default_plugins/Path
    Name: Planned path
    Enabled: true
    Topic:
      Value: /plan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Color: 255; 220; 60
    Line Style: Billboards
    Line Width: 0.04
  - Class: rviz_default_plugins/LaserScan
    Name: Scan
    Enabled: false
    Topic:
      Value: /scan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
    Color: 25; 255; 0
    Size (m): 0.05
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
  - Class: rviz_default_plugins/Image
    Name: Head camera
    Enabled: true
    Topic:
      Value: /camera/color/image_raw
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
    Normalize Range: true
  - Class: rviz_default_plugins/Image
    Name: Chest camera
    Enabled: true
    Topic:
      Value: /chest_camera/color/image_raw
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
    Normalize Range: true
  Global Options:
    Background Color: 38; 38; 42
    Fixed Frame: map
    Frame Rate: 15
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Measure
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Value: /goal_pose
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 55
      X: 5
      Y: 0
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 950
  Width: 1600
  Displays:
    collapsed: false
  Head camera:
    collapsed: false
  Chest camera:
    collapsed: false
