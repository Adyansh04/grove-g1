<mujoco model="g1_grasp_single_pinned_scene">
  <include file="g1_grasp_single_scene.staged.xml"/>

  <visual>
    <!-- From in front, where both hands and the table's edge show. -->
    <global azimuth="180" elevation="-20"/>
  </visual>

  <!-- Grasp contact settings, as in the other pinned overlays: elliptic cones, impratio against
       creep and a noslip pass. Timestep and integrator stay at the 2 ms Euler the bridge and the
       finger loops are tuned for. -->
  <option impratio="10" cone="elliptic" noslip_iterations="3"/>

  <equality>
    <!-- A repeatable arm base, and a head camera held still. -->
    <weld name="pelvis_world_pin" body1="pelvis"/>
    <weld name="torso_world_pin" body1="torso_link"/>
  </equality>
</mujoco>
