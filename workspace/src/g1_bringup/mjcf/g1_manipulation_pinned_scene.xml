<mujoco model="g1_manipulation_pinned_scene">
  <include file="g1_manipulation_scene.staged.xml"/>

  <!-- Grasp contact settings, as in g1_tabletop_pinned_scene. -->
  <option impratio="10" cone="elliptic" noslip_iterations="3"/>

  <equality>
    <!-- The pelvis, so the frame the arm plans in is the same every launch: with only the torso
         welded, the pelvis settles centimetres differently each time, enough to lose IK. -->
    <weld name="pelvis_world_pin" body1="pelvis"/>

    <!-- Nothing commands the waist until the freeze controller captures it, by which time the
         torso has fallen to its roll and pitch stops. This holds it at its spawn pose. -->
    <weld name="torso_world_pin" body1="torso_link"/>
  </equality>
</mujoco>
