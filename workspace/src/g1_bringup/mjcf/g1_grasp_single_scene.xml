    <mesh name="gso_toy_robot_0" file="@GROVE_ASSETS@/gso_toy_robot/mesh_0.obj"/>
    <material name="gso_toy_robot_0" rgba="1 1 1 1" specular="0.3" shininess="0.3" texture="gso_toy_robot_tex_0"/>
    <texture name="gso_action_figure_tex_0" type="2d" file="@GROVE_ASSETS@/gso_action_figure/tex_0.png"/>
    <texture name="gso_mug_ace_tex_0" type="2d" file="@GROVE_ASSETS@/gso_mug_ace/tex_0.png"/>
    <texture name="gso_serum_box_tex_0" type="2d" file="@GROVE_ASSETS@/gso_serum_box/tex_0.png"/>
