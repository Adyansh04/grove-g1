<mujoco model="g1_lio_scene">
  <!-- A walled 14 x 14 m room for scoring LiDAR-inertial odometry around the 5 m square
       (0,0) (5,0) (5,5) (0,5), marked on the floor; the robot spawns at the origin facing +x.
       Keep that path clear. Every geom is group 2, the only group the LiDAR sweep sees. -->

  <include file="g1_29dof.xml"/>

  <statistic center="2.5 2.5 0.8" extent="8"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.3 0.3 0.3" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.2 0.25 1"/>
    <global azimuth="120" elevation="-20" offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.2 0.3 0.42" rgb2="0.05 0.05 0.1"
             width="512" height="3072"/>
    <texture type="2d" name="floor_tile" builtin="checker"
             rgb1="0.78 0.80 0.84" rgb2="0.62 0.65 0.70" width="512" height="512"/>
    <material name="floor_mat" texture="floor_tile" texrepeat="14 14" specular="0.1"
              shininess="0.1" reflectance="0.02"/>
    <material name="wall_mat" rgba="0.55 0.58 0.62 1"/>
    <material name="feature_mat" rgba="0.35 0.45 0.60 1"/>
    <material name="marker_mat" rgba="0.90 0.35 0.15 1"/>
  </asset>

  <worldbody>
    <light pos="2.5 2.5 6" dir="0 0 -1" directional="true" diffuse="0.6 0.6 0.6"/>
    <geom name="floor" type="plane" size="9 9 0.05" material="floor_mat" group="2"
          pos="2.5 2.5 0"/>

    <!-- 2.5 m tall, well above the Mid360 at ~1.22 m, so near-horizontal rays hit wall at any
         range. -->
    <geom name="wall_north" type="box" size="7.0 0.1 1.25" pos="2.5 9.5 1.25"
          material="wall_mat" group="2"/>
    <geom name="wall_south" type="box" size="7.0 0.1 1.25" pos="2.5 -4.5 1.25"
          material="wall_mat" group="2"/>
    <geom name="wall_east" type="box" size="0.1 7.0 1.25" pos="9.5 2.5 1.25"
          material="wall_mat" group="2"/>
    <geom name="wall_west" type="box" size="0.1 7.0 1.25" pos="-4.5 2.5 1.25"
          material="wall_mat" group="2"/>

    <!-- Different in every quadrant, so scan matching cannot lock onto the wrong 90-degree
         rotation, and over 1.5 m from the path. -->
    <geom name="pillar_a" type="cylinder" size="0.25 1.25" pos="-2.5 -2.5 1.25"
          material="feature_mat" group="2"/>
    <geom name="pillar_b" type="cylinder" size="0.35 1.25" pos="7.5 -2.0 1.25"
          material="feature_mat" group="2"/>
    <geom name="tall_post" type="box" size="0.2 0.2 1.8" pos="7.8 7.5 1.8"
          material="feature_mat" group="2"/>
    <geom name="low_block" type="box" size="0.8 0.4 0.35" pos="-2.2 6.5 0.35"
          material="feature_mat" group="2"/>

    <!-- Three heights in one corner, for the vertical constraint flat walls do not give. -->
    <geom name="step_low" type="box" size="0.6 0.6 0.20" pos="-3.0 2.5 0.20"
          material="feature_mat" group="2"/>
    <geom name="step_mid" type="box" size="0.6 0.6 0.55" pos="-3.0 3.8 0.55"
          material="feature_mat" group="2"/>
    <geom name="step_high" type="box" size="0.6 0.6 0.95" pos="-3.0 5.1 0.95"
          material="feature_mat" group="2"/>

    <!-- The square's corners. Thin plates below min_obstacle_height, so never costmap
         obstacles. -->
    <geom name="mark_origin" type="box" size="0.15 0.15 0.005" pos="0 0 0.005"
          material="marker_mat" group="2"/>
    <geom name="mark_corner_x" type="box" size="0.15 0.15 0.005" pos="5 0 0.005"
          material="marker_mat" group="2"/>
    <geom name="mark_corner_xy" type="box" size="0.15 0.15 0.005" pos="5 5 0.005"
          material="marker_mat" group="2"/>
    <geom name="mark_corner_y" type="box" size="0.15 0.15 0.005" pos="0 5 0.005"
          material="marker_mat" group="2"/>
  </worldbody>
</mujoco>
