<mujoco model="g1_manipulation_scene">
  <!-- The skill scene: one block on a pedestal at arm's length, so a pick runs without
       navigating first. Every geom is group 2, the only group the LiDAR sweep sees. Staged into
       the vendored model directory at launch, so relative includes resolve. -->
  <include file="g1_29dof.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
      height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2"/>
    <material name="pedestal_mat" rgba="0.35 0.38 0.42 1"/>
    <material name="mat_red_obj" rgba="0.9 0.15 0.15 1" specular="0.6" shininess="0.8"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" group="2" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Top at 0.80 m, its near edge 8 cm clear of the spawned right palm. Contype bit 1 on the
         top and the block is what the Dex3's contact geometry (contype 2) pairs with. -->
    <geom name="table_top" group="2" type="box" size="0.19 0.17 0.015" pos="0.45 -0.20 0.785"
      material="pedestal_mat" contype="3" conaffinity="3"/>
    <geom name="table_leg_near" group="2" type="box" size="0.02 0.02 0.385"
      pos="0.60 -0.35 0.385" material="pedestal_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_far" group="2" type="box" size="0.02 0.02 0.385"
      pos="0.60 -0.05 0.385" material="pedestal_mat" contype="1" conaffinity="1"/>

    <!-- 60 x 60 x 90, spawned at rest height. Taller than wide because the thumb hangs 63 mm
         below the grip point: gripped at min_grip_height_m (80 mm) it clears the table by 17. -->
    <body name="red_block" pos="0.32 -0.20 0.847">
      <freejoint name="red_block_joint"/>
      <geom group="2" type="box" size="0.03 0.03 0.045" material="mat_red_obj" mass="0.22"
        contype="3" conaffinity="3" friction="1 0.005 0.0001"/>
    </body>

    <!-- The depth camera the sensor sampler renders through; it moves the camera to the torso
         mount every frame. -->
    <camera name="d435i" mode="fixed" fovy="58" resolution="848 480" pos="0 0 1"/>
  </worldbody>

  <!-- No grasp_* welds: the fingers hold the block by contact (patch 008). -->

  <equality>
    <!-- Spawn the arms at activate_arm's CLEAR_POSTURE: at the URDF zero the right hand is inside
         the block. These hold the pose until patch 007 hands each joint to its motor. -->
    <joint name="startup_hold_left_shoulder_pitch" joint1="left_shoulder_pitch_joint"
      polycoef="0.9 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_shoulder_roll" joint1="left_shoulder_roll_joint"
      polycoef="1.1 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_shoulder_yaw" joint1="left_shoulder_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_elbow" joint1="left_elbow_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_wrist_roll" joint1="left_wrist_roll_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_wrist_pitch" joint1="left_wrist_pitch_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_wrist_yaw" joint1="left_wrist_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_shoulder_pitch" joint1="right_shoulder_pitch_joint"
      polycoef="0.9 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_shoulder_roll" joint1="right_shoulder_roll_joint"
      polycoef="-1.1 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_shoulder_yaw" joint1="right_shoulder_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_elbow" joint1="right_elbow_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_wrist_roll" joint1="right_wrist_roll_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_wrist_pitch" joint1="right_wrist_pitch_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_wrist_yaw" joint1="right_wrist_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
  </equality>
</mujoco>
