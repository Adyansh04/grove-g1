<mujoco model="g1_manipulation_scene">
  <!-- The fast skill scene: one object, on a pedestal, at arm's length in front of the robot.

       Exists so a pick can be exercised without navigating to the facility workbench first,
       and without waiting on the gait to hold still once it has. The pedestal top is at the
       workbench's own 0.75 m and the object is the same 6 x 9 cm block, so a grasp tuned here is
       tuned for there.

       Deliberately measured against by nothing else. g1_perception_scene is what the LiDAR
       and octomap tests assert geometry from, and adding a pedestal to it would move numbers
       those tests were written against.

       Every geom is group 2, for the reason g1_perception_scene explains: the sweep masks to
       that group, or every ray returns the robot's own shell.

       Staged into the vendored model directory at launch, so relative includes resolve. -->
  <include file="g1_29dof.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
      height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2"/>
    <material name="pedestal_mat" rgba="0.35 0.38 0.42 1"/>
    <material name="mat_red_obj" rgba="0.9 0.15 0.15 1" specular="0.6" shininess="0.8"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" group="2" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- The near edge must clear the spawned arm. The right palm hangs at about odom
         (0.18, -0.18, 0.74) at spawn: arms down, elbows bent forward by the pose
         arm_freeze_controller captures. So the top starts at x 0.26, 8 cm clear of it, and
         sits at 0.80, above where the palm hangs rather than around it.

         Height is chosen to match the facility workbench (0.75) as closely as the arm's reach
         allows, so a grasp tuned here transfers. -->
    <!-- Bit 1 on the top and on the block is what the Dex3's contact geometry pairs with: the hand
         is contype 2 and meets nothing until a scene opts in. The legs keep bit 0 alone. -->
    <geom name="table_top" group="2" type="box" size="0.19 0.17 0.015" pos="0.45 -0.20 0.785"
      material="pedestal_mat" contype="3" conaffinity="3"/>
    <geom name="table_leg_near" group="2" type="box" size="0.02 0.02 0.385"
      pos="0.60 -0.35 0.385" material="pedestal_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_far" group="2" type="box" size="0.02 0.02 0.385"
      pos="0.60 -0.05 0.385" material="pedestal_mat" contype="1" conaffinity="1"/>

    <!-- Same size, mass and friction as the facility scene's, so the two are the same problem.
         On the near half of the top, which is the part the arm can reach, and spawned at
         rest height (half-height above the 0.80 surface) rather than a few mm above it, so it
         settles instead of bouncing.

         60 x 60 x 90, and taller than it is wide for a reason no tuning gets around. The thumb
         hangs 63 mm below the grip point while the hand descends, so its clearance over the table
         is (grip height - 63); the grip point can never be above the object itself, and the hand
         cannot take anything wider than 75 mm. A cube therefore has at most 75 - 63 = 12 mm, and
         the descent lands within 6-10 mm, so a cube scrapes the surface on the way in. At 90 mm
         tall the grip point goes to 80 and the clearance is 17 mm. See g1_common.xacro. -->
    <body name="red_block" pos="0.32 -0.20 0.847">
      <freejoint name="red_block_joint"/>
      <geom group="2" type="box" size="0.03 0.03 0.045" material="mat_red_obj" mass="0.22"
        contype="3" conaffinity="3" friction="1 0.005 0.0001"/>
    </body>

    <!-- The depth camera element the sensor sampler renders through, exactly as the other
         scenes carry it: the mount belongs to the vendored robot and cannot host a camera, so
         the sampler writes this one's pose from torso_link every frame. -->
    <camera name="d435i" mode="fixed" fovy="58" resolution="848 480" pos="0 0 1"/>
  </worldbody>

  <!-- No grasp_* welds: the fingers have contact geometry (patch 008) and hold the block by
       gripping it. grasp_weld finds nothing to manage here and says so at startup. -->

  <equality>
    <!-- Spawn the arms at activate_arm's CLEAR_POSTURE. Same reason as the tabletop scene: at the
         URDF zero the right hand is inside the block, and a hand with contact geometry would throw
         it. ApplyStartupPose puts the joints here before the first step, so these hold rather than
         pull, and patch 007 hands each to its motor. -->
    <joint name="startup_hold_left_shoulder_pitch" joint1="left_shoulder_pitch_joint"
      polycoef="0.9 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_shoulder_roll" joint1="left_shoulder_roll_joint"
      polycoef="1.1 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_shoulder_yaw" joint1="left_shoulder_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_elbow" joint1="left_elbow_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_wrist_roll" joint1="left_wrist_roll_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_wrist_pitch" joint1="left_wrist_pitch_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_wrist_yaw" joint1="left_wrist_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_shoulder_pitch" joint1="right_shoulder_pitch_joint"
      polycoef="0.9 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_shoulder_roll" joint1="right_shoulder_roll_joint"
      polycoef="-1.1 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_shoulder_yaw" joint1="right_shoulder_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_elbow" joint1="right_elbow_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_wrist_roll" joint1="right_wrist_roll_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_wrist_pitch" joint1="right_wrist_pitch_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_wrist_yaw" joint1="right_wrist_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
  </equality>
</mujoco>
