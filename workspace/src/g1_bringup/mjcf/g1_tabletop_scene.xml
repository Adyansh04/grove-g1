<mujoco model="g1_tabletop_scene">
  <!-- The perception scene: five objects on one pedestal, at arm's length in front of the robot.

       g1_manipulation_scene is deliberately one cube, because a pick test wants one answer. This
       is the other half of the question: several objects a detector has to tell apart, close
       enough together that a mask which runs onto its neighbour shows up as a wrong pose rather
       than as a missing one.

       Shapes are as different as the pedestal allows on purpose. A box the detector can name by
       colour, a cylinder whose silhouette hides its own base, a sphere whose lowest visible point
       is its equator, and a cup that is a cylinder of another colour. Whether the geometry
       recovers a sphere's height is the thing the support-plane fit exists to get right.

       Every geom is group 2, for the reason g1_perception_scene explains: the sweep masks to that
       group, or every ray returns the robot's own shell.

       Staged into the vendored model directory at launch, so relative includes resolve. -->
  <include file="g1_29dof.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
      height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2"/>
    <material name="pedestal_mat" rgba="0.35 0.38 0.42 1"/>
    <material name="mat_red_obj" rgba="0.9 0.15 0.15 1" specular="0.6" shininess="0.8"/>
    <material name="mat_green_obj" rgba="0.15 0.8 0.2 1" specular="0.6" shininess="0.8"/>
    <material name="mat_blue_obj" rgba="0.15 0.3 0.9 1" specular="0.6" shininess="0.8"/>
    <material name="mat_yellow_obj" rgba="0.95 0.8 0.1 1" specular="0.6" shininess="0.8"/>
    <material name="mat_white_obj" rgba="0.92 0.92 0.9 1" specular="0.4" shininess="0.5"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" group="2" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Wider than the manipulation pedestal, because five objects have to sit apart without
         touching, and at the same 0.80 top so a grasp tuned on one scene transfers to the other.
         Widened again when the fingers gained contact geometry: the objects grew with it, and
         five of them need the room. The near edge stays at x 0.26, which is the reach the arm
         was measured against. -->
    <!-- Bit 1 on the top and on every object is what the Dex3's contact geometry pairs with: the
         hand is contype 2 and meets nothing until a scene opts in. The legs keep bit 0 alone,
         since nothing reaches them. -->
    <geom name="table_top" group="2" type="box" size="0.16 0.22 0.015" pos="0.42 -0.27 0.785"
      material="pedestal_mat" contype="3" conaffinity="3"/>
    <geom name="table_leg_near" group="2" type="box" size="0.02 0.02 0.385"
      pos="0.54 -0.46 0.385" material="pedestal_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_far" group="2" type="box" size="0.02 0.02 0.385"
      pos="0.54 -0.08 0.385" material="pedestal_mat" contype="1" conaffinity="1"/>

    <!-- Same size, mass and friction as the manipulation scene's cube, so a pick tuned there is
         tuned here. Nearest the robot, on the half the arm can reach.

         60 x 60 x 90, taller than it is wide, and no longer a cube because no cube works. The
         descending thumb hangs 63 mm below the grip point, so its clearance over the table is
         (grip height - 63); the grip point cannot be above the object, and the hand takes nothing
         wider than 75 mm. That caps a cube at 12 mm of clearance against a descent that lands
         within 6-10 mm, which is how the thumb came to scrape the table. See g1_common.xacro. -->
    <body name="red_cube" pos="0.32 -0.20 0.847">
      <freejoint name="red_cube_joint"/>
      <geom group="2" type="box" size="0.03 0.03 0.045" material="mat_red_obj" mass="0.22"
        contype="3" conaffinity="3" friction="1 0.005 0.0001"/>
    </body>

    <!-- 60 x 90, which is the comfortable middle of that window rather than its edge: the same
         pick should work on a shape whose gripped face is curved, not only on the flat one. -->
    <body name="green_cylinder" pos="0.32 -0.35 0.847">
      <freejoint name="green_cylinder_joint"/>
      <geom group="2" type="cylinder" size="0.03 0.045" material="mat_green_obj" mass="0.15"
        contype="3" conaffinity="3" friction="1 0.005 0.0001"/>
    </body>

    <!-- The shape the support plane matters most for: seen from above, its lowest visible point
         is its equator, so a fit that takes the object's own lowest point reports half a ball. -->
    <body name="blue_sphere" pos="0.48 -0.25 0.839">
      <freejoint name="blue_sphere_joint"/>
      <geom group="2" type="sphere" size="0.037" material="mat_blue_obj" mass="0.1"
        contype="3" conaffinity="3" friction="0.8 0.005 0.0001"/>
    </body>

    <!-- Rectangular rather than square, so its yaw is recoverable at all: a square top face has
         no principal direction to find. -->
    <body name="yellow_box" pos="0.46 -0.11 0.827">
      <freejoint name="yellow_box_joint"/>
      <geom group="2" type="box" size="0.04 0.025 0.025" material="mat_yellow_obj" mass="0.12"
        contype="3" conaffinity="3"/>
    </body>

    <body name="white_cup" pos="0.47 -0.42 0.847">
      <freejoint name="white_cup_joint"/>
      <geom group="2" type="cylinder" size="0.035 0.045" material="mat_white_obj" mass="0.12"
        contype="3" conaffinity="3" friction="1 0.005 0.0001"/>
    </body>

    <!-- The depth camera element the sensor sampler renders through, exactly as the other scenes
         carry it: the mount belongs to the vendored robot and cannot host a camera, so the
         sampler writes this one's pose from torso_link every frame. -->
    <camera name="d435i" mode="fixed" fovy="58" resolution="848 480" pos="0 0 1"/>
  </worldbody>

  <!-- No grasp_* welds: the fingers have contact geometry (patch 008) and hold the object by
       gripping it. grasp_weld finds nothing to manage here and says so at startup. -->

  <equality>
    <!-- Spawn the arms at activate_arm's CLEAR_POSTURE, clear of the table and the objects. In the
         base scene rather than the pinned overlay because it is the layout that demands it: at the
         URDF zero the right hand is inside the green cylinder, whichever variant is staged.
         ApplyStartupPose puts the joints here before the first step, so these start satisfied and
         only hold against gravity; patch 007 then hands each to its motor and releases it. -->
    <joint name="startup_hold_left_shoulder_pitch" joint1="left_shoulder_pitch_joint"
      polycoef="0.9 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_shoulder_roll" joint1="left_shoulder_roll_joint"
      polycoef="1.1 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_shoulder_yaw" joint1="left_shoulder_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_elbow" joint1="left_elbow_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_wrist_roll" joint1="left_wrist_roll_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_wrist_pitch" joint1="left_wrist_pitch_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_wrist_yaw" joint1="left_wrist_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_shoulder_pitch" joint1="right_shoulder_pitch_joint"
      polycoef="0.9 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_shoulder_roll" joint1="right_shoulder_roll_joint"
      polycoef="-1.1 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_shoulder_yaw" joint1="right_shoulder_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_elbow" joint1="right_elbow_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_wrist_roll" joint1="right_wrist_roll_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_wrist_pitch" joint1="right_wrist_pitch_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_wrist_yaw" joint1="right_wrist_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
  </equality>
</mujoco>
