<mujoco model="g1_grasp_eval_scene">
  <!-- Eight objects of different shapes on one table, four in reach of each hand, for measuring
       grasps: what the hand touches on the way and how centred each grip sits (the simulator's
       contact monitor, sim.launch.py contact_log:=). The front row is 0.28 m out and two sit
       0.38 m out, near the arm's reach; every object is 120 mm or more from the next. Every geom is group 2, the only group the LiDAR
       sweep sees, and contype 3, so the hands' contact geometry (contype 2) meets it. -->
  <include file="g1_29dof.xml"/>

  <statistic center="0.3 0 0.8" extent="1.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="180" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
      height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2"/>
    <material name="table_mat" rgba="0.35 0.38 0.42 1"/>
    <material name="mat_red_obj" rgba="0.9 0.15 0.15 1" specular="0.6" shininess="0.8"/>
    <material name="mat_green_obj" rgba="0.15 0.8 0.2 1" specular="0.6" shininess="0.8"/>
    <material name="mat_blue_obj" rgba="0.15 0.3 0.9 1" specular="0.6" shininess="0.8"/>
    <material name="mat_yellow_obj" rgba="0.95 0.8 0.1 1" specular="0.6" shininess="0.8"/>
    <material name="mat_white_obj" rgba="0.92 0.92 0.9 1" specular="0.4" shininess="0.5"/>
    <material name="mat_orange_obj" rgba="0.95 0.5 0.1 1" specular="0.5" shininess="0.6"/>
    <material name="mat_purple_obj" rgba="0.55 0.2 0.75 1" specular="0.5" shininess="0.6"/>
    <material name="mat_brown_obj" rgba="0.6 0.4 0.22 1" specular="0.2" shininess="0.3"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" group="2" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- The same 0.80 m top as the other manipulation tables, wide enough for both hands. -->
    <geom name="table_top" group="2" type="box" size="0.18 0.45 0.015" pos="0.38 0 0.785"
      material="table_mat" contype="3" conaffinity="3"/>
    <geom name="table_leg_near_right" group="2" type="box" size="0.02 0.02 0.385"
      pos="0.52 -0.42 0.385" material="table_mat" contype="1" conaffinity="1"/>
    <geom name="table_leg_near_left" group="2" type="box" size="0.02 0.02 0.385"
      pos="0.52 0.42 0.385" material="table_mat" contype="1" conaffinity="1"/>

    <!-- A 50 mm cube: the plain case. -->
    <body name="red_cube" pos="0.28 -0.08 0.8250">
      <freejoint name="red_cube_joint"/>
      <geom group="2" type="box" size="0.025 0.025 0.025" material="mat_red_obj" mass="0.100" contype="3" conaffinity="3" friction="1 0.005 0.0001"/>
    </body>
    <!-- A drinks can, 66 mm across and 115 mm tall: round, and taller than the hand is wide. -->
    <body name="green_can" pos="0.28 -0.22 0.8575">
      <freejoint name="green_can_joint"/>
      <geom group="2" type="cylinder" size="0.033 0.0575" material="mat_green_obj" mass="0.200" contype="3" conaffinity="3" friction="1 0.005 0.0001"/>
    </body>
    <!-- A 70 mm ball: it rolls from a grip that is off centre. -->
    <body name="yellow_ball" pos="0.38 -0.15 0.8350">
      <freejoint name="yellow_ball_joint"/>
      <geom group="2" type="sphere" size="0.035" material="mat_yellow_obj" mass="0.060" contype="3" conaffinity="3" friction="1 0.005 0.0001"/>
    </body>
    <!-- 40 x 70 x 110 mm, turned 35 degrees: its narrow side is not where the hand closes. -->
    <body name="blue_tall_box" pos="0.28 -0.36 0.8550" quat="0.9537 0 0 0.3007">
      <freejoint name="blue_tall_box_joint"/>
      <geom group="2" type="box" size="0.02 0.035 0.055" material="mat_blue_obj" mass="0.150" contype="3" conaffinity="3" friction="1 0.005 0.0001"/>
    </body>
    <!-- 84 mm across and 45 mm tall: wide and low, close to the table. -->
    <body name="white_tuna_can" pos="0.28 0.08 0.8225">
      <freejoint name="white_tuna_can_joint"/>
      <geom group="2" type="cylinder" size="0.042 0.0225" material="mat_white_obj" mass="0.150" contype="3" conaffinity="3" friction="1 0.005 0.0001"/>
    </body>
    <!-- A rounded bottle, 50 mm across and 150 mm tall. -->
    <body name="orange_bottle" pos="0.28 0.22 0.8750">
      <freejoint name="orange_bottle_joint"/>
      <geom group="2" type="capsule" size="0.025 0.05" material="mat_orange_obj" mass="0.200" contype="3" conaffinity="3" friction="1 0.005 0.0001"/>
    </body>
    <!-- A 35 mm cube: small, so the grip is near the table. -->
    <body name="purple_small_cube" pos="0.38 0.15 0.8175">
      <freejoint name="purple_small_cube_joint"/>
      <geom group="2" type="box" size="0.0175 0.0175 0.0175" material="mat_purple_obj" mass="0.050" contype="3" conaffinity="3" friction="1 0.005 0.0001"/>
    </body>
    <!-- An L of two blocks, 60 x 100 x 100 mm: its box overstates what is there to grip. -->
    <body name="brown_l_block" pos="0.28 0.36 0.8500">
      <freejoint name="brown_l_block_joint"/>
      <geom group="2" type="box" size="0.03 0.05 0.015" pos="0 0 -0.035" material="mat_brown_obj" mass="0.050" contype="3" conaffinity="3" friction="1 0.005 0.0001"/>
      <geom group="2" type="box" size="0.03 0.015 0.05" pos="0 0.035 0" material="mat_brown_obj" mass="0.050" contype="3" conaffinity="3" friction="1 0.005 0.0001"/>
    </body>

    <!-- The depth cameras the sensor sampler renders through; it moves each to its mount in
         g1_description's cameras.yaml every frame. -->
    <camera name="d435i" mode="fixed" fovy="58" resolution="848 480" pos="0 0 1"/>
    <camera name="chest_d435i" mode="fixed" fovy="58" resolution="848 480" pos="0 0 1"/>
  </worldbody>

  <!-- A held object is welded to the palm once the thumb and a finger both touch it, so a carry is
       repeatable; the contact monitor measures the grip at that same instant. -->
  <equality>
    <weld name="grasp_left_red_cube" body1="left_hand_palm_link" body2="red_cube" active="false"/>
    <weld name="grasp_right_red_cube" body1="right_hand_palm_link" body2="red_cube" active="false"/>
    <weld name="grasp_left_green_can" body1="left_hand_palm_link" body2="green_can" active="false"/>
    <weld name="grasp_right_green_can" body1="right_hand_palm_link" body2="green_can" active="false"/>
    <weld name="grasp_left_yellow_ball" body1="left_hand_palm_link" body2="yellow_ball" active="false"/>
    <weld name="grasp_right_yellow_ball" body1="right_hand_palm_link" body2="yellow_ball" active="false"/>
    <weld name="grasp_left_blue_tall_box" body1="left_hand_palm_link" body2="blue_tall_box" active="false"/>
    <weld name="grasp_right_blue_tall_box" body1="right_hand_palm_link" body2="blue_tall_box" active="false"/>
    <weld name="grasp_left_white_tuna_can" body1="left_hand_palm_link" body2="white_tuna_can" active="false"/>
    <weld name="grasp_right_white_tuna_can" body1="right_hand_palm_link" body2="white_tuna_can" active="false"/>
    <weld name="grasp_left_orange_bottle" body1="left_hand_palm_link" body2="orange_bottle" active="false"/>
    <weld name="grasp_right_orange_bottle" body1="right_hand_palm_link" body2="orange_bottle" active="false"/>
    <weld name="grasp_left_purple_small_cube" body1="left_hand_palm_link" body2="purple_small_cube" active="false"/>
    <weld name="grasp_right_purple_small_cube" body1="right_hand_palm_link" body2="purple_small_cube" active="false"/>
    <weld name="grasp_left_brown_l_block" body1="left_hand_palm_link" body2="brown_l_block" active="false"/>
    <weld name="grasp_right_brown_l_block" body1="right_hand_palm_link" body2="brown_l_block" active="false"/>
  </equality>

  <equality>
    <!-- Spawn the arms at activate_arm's CLEAR_POSTURE: at the URDF zero the right hand is inside
         the green cylinder. These hold the pose until the simulator hands each joint to its motor. -->
    <joint name="startup_hold_left_shoulder_pitch" joint1="left_shoulder_pitch_joint"
      polycoef="0.9 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_shoulder_roll" joint1="left_shoulder_roll_joint"
      polycoef="1.1 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_shoulder_yaw" joint1="left_shoulder_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_elbow" joint1="left_elbow_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_wrist_roll" joint1="left_wrist_roll_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_wrist_pitch" joint1="left_wrist_pitch_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_left_wrist_yaw" joint1="left_wrist_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_shoulder_pitch" joint1="right_shoulder_pitch_joint"
      polycoef="0.9 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_shoulder_roll" joint1="right_shoulder_roll_joint"
      polycoef="-1.1 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_shoulder_yaw" joint1="right_shoulder_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_elbow" joint1="right_elbow_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_wrist_roll" joint1="right_wrist_roll_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_wrist_pitch" joint1="right_wrist_pitch_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
    <joint name="startup_hold_right_wrist_yaw" joint1="right_wrist_yaw_joint"
      polycoef="0 0 0 0 0" solref="0.05 1"/>
  </equality>
</mujoco>
