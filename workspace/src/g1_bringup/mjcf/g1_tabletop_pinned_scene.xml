<mujoco model="g1_tabletop_pinned_scene">
  <include file="g1_tabletop_scene.staged.xml"/>

  <equality>
    <!-- Same pair and the same reason as g1_manipulation_pinned_scene: the pelvis weld fixes the
         base the arm reaches from, and the torso weld holds the head camera still, which is what
         a perception measurement is compared against. -->
    <weld name="pelvis_world_pin" body1="pelvis"/>
    <weld name="torso_world_pin" body1="torso_link"/>
  </equality>
</mujoco>
