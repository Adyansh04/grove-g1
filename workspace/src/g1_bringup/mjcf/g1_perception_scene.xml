<mujoco model="g1_perception_scene">
  <!-- A room of known geometry, so every sensor assertion is a fact of this file. Staged next to
       the vendored g1_29dof.xml at launch, so the include resolves.

       Every geom is group 2, the only group the LiDAR sweep sees: the Mid360 mount sits inside
       the torso's collision geom, so unmasked rays return the robot's own shell. Not group 3,
       which the viewer does not render. There is no sensor site: the simulator composes
       torso_link's live pose with the URDF mount offsets, leaving g1_29dof.xml untouched. -->
  <include file="g1_29dof.xml"/>

  <statistic center="0 0 0.5" extent="2.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
      height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2"/>
    <material name="wall" rgba="0.75 0.75 0.72 1"/>
    <material name="obstacle" rgba="0.8 0.4 0.3 1"/>
    <!-- Saturated green appears nowhere else here, so the colour check is a one-channel
         threshold. -->
    <material name="color_target" rgba="0 0.9 0.1 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" group="2" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- 8 x 8 m room, inner wall faces at +/-4.0 m. The y walls run to +/-4.1 in x to close the
         corners. -->
    <geom name="wall_px" group="2" type="box" size="0.05 4.0 1.25" pos="4.05 0 1.25" material="wall"/>
    <geom name="wall_nx" group="2" type="box" size="0.05 4.0 1.25" pos="-4.05 0 1.25" material="wall"/>
    <geom name="wall_py" group="2" type="box" size="4.1 0.05 1.25" pos="0 4.05 1.25" material="wall"/>
    <geom name="wall_ny" group="2" type="box" size="4.1 0.05 1.25" pos="0 -4.05 1.25" material="wall"/>

    <!-- Clear of the spawn and of the +x walking path. -->
    <geom name="obstacle_box" group="2" type="box" size="0.3 0.3 0.5" pos="2.0 1.6 0.5"
          material="obstacle"/>
    <!-- Colour-check target, 1.21 m out where the camera's centre ray meets the floor but 0.35 m
         left, so the centre pixel stays on bare floor for the depth check. -->
    <geom name="color_target" group="2" type="box" size="0.05 0.05 0.05" pos="1.21 0.35 0.05"
      material="color_target"/>

    <geom name="obstacle_cyl" group="2" type="cylinder" size="0.25 0.75" pos="-1.5 -2.0 0.75"
          material="obstacle"/>

    <!-- The only obstacle within the arms' reach, for g1_moveit_config's
         test_octomap_blocks_a_plan: a slab over x 0.18 to 0.38 and z 1.00 to 1.50 around where
         that test puts the right palm, with the torso and resting hands behind it. -->
    <geom name="reach_obstacle" group="2" type="box" size="0.10 0.45 0.25" pos="0.28 0.0 1.25"
          material="obstacle"/>

    <!-- D435i intrinsics only. The pose is a placeholder the sensor thread overwrites every frame
         from torso_link, since the vendored robot cannot host a camera element. -->
    <camera name="d435i" mode="fixed" fovy="58" resolution="848 480" pos="0 0 1"/>
  </worldbody>

</mujoco>
