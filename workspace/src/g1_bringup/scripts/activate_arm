#!/usr/bin/env python3
"""Acquires control authority over the G1 arms.

There is no arm component to activate: G1LowCmdSystem owns all 29 body motors
and is active from bring-up, holding the arms through arm_freeze_controller.
Acquiring is one switch that trades that freeze for arm_trajectory_controller,
and it must be one switch, because a joint this component sees unclaimed is a
joint it leaves unpowered.

The hands are separate components and are activated after the arm.

Python, not C++: this is a one-shot administrative sequencing tool (service
calls + a bounded retry loop, well under 1 Hz), the same category as the
launch files it's a sibling to -- not a control loop, so there's no
real-time/hot-path argument for C++ here.
"""

import sys
import time

import rclpy
from controller_manager_msgs.srv import SetHardwareComponentState, SwitchController
from lifecycle_msgs.msg import State
from rclpy.node import Node

CONTROLLER_NAME = "arm_trajectory_controller"
# What holds the arms until the trajectory controller displaces it.
ARM_FREEZE_CONTROLLER = "arm_freeze_controller"

# The hands, acquired in the same order and by the same rules. Best-effort on purpose: a Dex3
# that is absent, unpowered or not publishing state must not stop the arm from being usable,
# and G1Dex3System refuses to activate without fresh feedback rather than drive from a stale one.
HANDS = (
    ("G1Dex3SystemLeft", "left_hand_controller"),
    ("G1Dex3SystemRight", "right_hand_controller"),
)
# Shorter than the arm's: an absent hand should be reported quickly, not waited out twice.
HAND_ACTIVATE_TIMEOUT_S = 5.0

COMPONENT_RETRY_PERIOD_S = 0.5
COMPONENT_ACTIVATE_TIMEOUT_S = 15.0
SERVICE_CALL_TIMEOUT_S = 5.0


def set_component_state(node, client, name, target_state_id, target_label, retry_timeout_s):
    """Bounded retry: the component/controller_manager may not be discovered
    yet, or activation may be legitimately refused if feedback just barely
    missed the freshness window (see g1_hand_interface's on_activate).
    """
    deadline = time.monotonic() + retry_timeout_s
    last_error = "no attempt made"
    while time.monotonic() < deadline:
        if not client.wait_for_service(timeout_sec=1.0):
            last_error = "set_hardware_component_state service not available yet"
            time.sleep(COMPONENT_RETRY_PERIOD_S)
            continue

        request = SetHardwareComponentState.Request()
        request.name = name
        request.target_state.id = target_state_id
        request.target_state.label = target_label

        future = client.call_async(request)
        rclpy.spin_until_future_complete(node, future, timeout_sec=SERVICE_CALL_TIMEOUT_S)
        result = future.result() if future.done() else None
        if result is not None and result.ok:
            return True
        last_error = f"rejected (result={result})"
        time.sleep(COMPONENT_RETRY_PERIOD_S)

    node.get_logger().error(f"timed out setting {name} to {target_label!r}: {last_error}")
    return False


def switch_controller(node, client, activate, deactivate, timeout_s):
    if not client.wait_for_service(timeout_sec=timeout_s):
        node.get_logger().error("switch_controller service not available")
        return False

    request = SwitchController.Request()
    request.activate_controllers = activate
    request.deactivate_controllers = deactivate
    request.strictness = SwitchController.Request.STRICT
    request.activate_asap = True
    request.timeout.sec = int(timeout_s)

    future = client.call_async(request)
    rclpy.spin_until_future_complete(node, future, timeout_sec=timeout_s + 1.0)
    result = future.result() if future.done() else None
    return result is not None and result.ok


def retry_switch(node, client, activate, deactivate, retry_timeout_s):
    """Same patience the component activation gets: controller_manager may not be discovered
    yet, and this switch is the whole arm acquire.
    """
    deadline = time.monotonic() + retry_timeout_s
    while time.monotonic() < deadline:
        if switch_controller(node, client, activate, deactivate, SERVICE_CALL_TIMEOUT_S):
            return True
        time.sleep(COMPONENT_RETRY_PERIOD_S)
    return False


def main(argv=None):
    rclpy.init()
    node = Node("g1_bringup_activate_arm")
    try:
        component_client = node.create_client(
            SetHardwareComponentState, "/controller_manager/set_hardware_component_state"
        )
        controller_client = node.create_client(
            SwitchController, "/controller_manager/switch_controller"
        )

        # One switch, not two: see this script's module docstring.
        node.get_logger().info(f"activating controller {CONTROLLER_NAME}...")
        if not retry_switch(
            node,
            controller_client,
            [CONTROLLER_NAME],
            [ARM_FREEZE_CONTROLLER],
            COMPONENT_ACTIVATE_TIMEOUT_S,
        ):
            node.get_logger().error(f"failed to activate {CONTROLLER_NAME}")
            return 1

        for component, controller in HANDS:
            node.get_logger().info(f"activating hand {component}...")
            if not set_component_state(
                node,
                component_client,
                component,
                State.PRIMARY_STATE_ACTIVE,
                "active",
                HAND_ACTIVATE_TIMEOUT_S,
            ) or not switch_controller(
                node, controller_client, [controller], [], SERVICE_CALL_TIMEOUT_S
            ):
                node.get_logger().warning(
                    f"{component} did not come up; the arm is still usable but this hand "
                    "will not move. Check that it is powered and publishing state."
                )

        node.get_logger().info("activation complete: the arm and both hands are acquired.")
        return 0
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    sys.exit(main())
