#!/usr/bin/env python3
"""Acquires the G1 arms and hands, then moves the arms somewhere a planner can work from.

G1LowCmdSystem is active from bring-up and holds the arms through arm_freeze_controller. Acquiring
swaps that for arm_trajectory_controller in one switch, because a joint the component sees
unclaimed is left unpowered. The hands are separate components and follow, best-effort.

The arms then move out to the sides unplanned: where they hang at bring-up is inside the octomap
of any table in front, and MoveIt cannot plan from a start state in collision.

With --posture sides the arms hang beside the thighs instead, for exploration: at zero the
forearms point forward, into both cameras' views, and a real detector maps the hands as objects.
--no-hands leaves the Dex3 hands alone.

Python, not C++: one-shot sequencing well under 1 Hz.
"""

import argparse
import sys
import time

import rclpy
from control_msgs.action import FollowJointTrajectory
from controller_manager_msgs.srv import SetHardwareComponentState, SwitchController
from lifecycle_msgs.msg import State
from rclpy.action import ActionClient
from rclpy.duration import Duration
from rclpy.node import Node
from rclpy.utilities import remove_ros_args
from trajectory_msgs.msg import JointTrajectoryPoint

CONTROLLER_NAME = "arm_trajectory_controller"
# What holds the arms until the trajectory controller displaces it.
ARM_FREEZE_CONTROLLER = "arm_freeze_controller"

# Best-effort: a Dex3 that is absent or not publishing state must not cost the arm, and
# G1Dex3System refuses to activate without fresh feedback.
HANDS = (
    ("G1Dex3SystemLeft", "left_hand_controller"),
    ("G1Dex3SystemRight", "right_hand_controller"),
)
# Shorter than the arm's: an absent hand should be reported quickly, not waited out twice.
HAND_ACTIVATE_TIMEOUT_S = 5.0

# Out to the sides with the palms near hip height, clear of any table. Left arm values; the pose
# is symmetric, so the arms' mass cancels laterally.
CLEAR_POSTURE = {
    "shoulder_pitch_joint": 0.90,
    "shoulder_roll_joint": 1.10,
    "shoulder_yaw_joint": 0.0,
    "elbow_joint": 0.0,
    "wrist_roll_joint": 0.0,
    "wrist_pitch_joint": 0.0,
    "wrist_yaw_joint": 0.0,
}
# Nearly straight, beside the thighs, with the roll keeping the palms off them. Every hand and
# forearm link is then at least 40 px outside both camera images.
SIDES_POSTURE = {
    "shoulder_pitch_joint": 0.0,
    "shoulder_roll_joint": 0.20,
    "shoulder_yaw_joint": 0.0,
    "elbow_joint": 1.40,
    "wrist_roll_joint": 0.0,
    "wrist_pitch_joint": 0.0,
    "wrist_yaw_joint": 0.0,
}
POSTURES = {"clear": CLEAR_POSTURE, "sides": SIDES_POSTURE}
# Ramped, not snapped: this is a real motion on a real arm.
POSTURE_DURATION_S = 4.0
ARM_TRAJECTORY_ACTION = "/arm_trajectory_controller/follow_joint_trajectory"

COMPONENT_RETRY_PERIOD_S = 0.5
COMPONENT_ACTIVATE_TIMEOUT_S = 15.0
SERVICE_CALL_TIMEOUT_S = 5.0


def set_component_state(node, client, name, target_state_id, target_label, retry_timeout_s):
    """Bounded retry: controller_manager may not be discovered yet, and activation is legitimately
    refused when feedback just missed the freshness window (g1_hand_interface's on_activate)."""
    deadline = time.monotonic() + retry_timeout_s
    last_error = "no attempt made"
    while time.monotonic() < deadline:
        if not client.wait_for_service(timeout_sec=1.0):
            last_error = "set_hardware_component_state service not available yet"
            time.sleep(COMPONENT_RETRY_PERIOD_S)
            continue

        request = SetHardwareComponentState.Request()
        request.name = name
        request.target_state.id = target_state_id
        request.target_state.label = target_label

        future = client.call_async(request)
        rclpy.spin_until_future_complete(node, future, timeout_sec=SERVICE_CALL_TIMEOUT_S)
        result = future.result() if future.done() else None
        if result is not None and result.ok:
            return True
        last_error = f"rejected (result={result})"
        time.sleep(COMPONENT_RETRY_PERIOD_S)

    node.get_logger().error(f"timed out setting {name} to {target_label!r}: {last_error}")
    return False


def switch_controller(node, client, activate, deactivate, timeout_s):
    if not client.wait_for_service(timeout_sec=timeout_s):
        node.get_logger().error("switch_controller service not available")
        return False

    request = SwitchController.Request()
    request.activate_controllers = activate
    request.deactivate_controllers = deactivate
    request.strictness = SwitchController.Request.STRICT
    request.activate_asap = True
    request.timeout.sec = int(timeout_s)

    future = client.call_async(request)
    rclpy.spin_until_future_complete(node, future, timeout_sec=timeout_s + 1.0)
    result = future.result() if future.done() else None
    return result is not None and result.ok


def retry_switch(node, client, activate, deactivate, retry_timeout_s):
    """Same patience the component activation gets; this switch is the whole arm acquire."""
    deadline = time.monotonic() + retry_timeout_s
    while time.monotonic() < deadline:
        if switch_controller(node, client, activate, deactivate, SERVICE_CALL_TIMEOUT_S):
            return True
        time.sleep(COMPONENT_RETRY_PERIOD_S)
    return False


def move_arms(node, name, timeout_s=20.0):
    """Sends the arms to a posture through the controller, with no planner involved."""
    client = ActionClient(node, FollowJointTrajectory, ARM_TRAJECTORY_ACTION)
    if not client.wait_for_server(timeout_sec=timeout_s):
        node.get_logger().warning(
            f"{ARM_TRAJECTORY_ACTION} is not serving; leaving the arms where they hang"
        )
        return False

    goal = FollowJointTrajectory.Goal()
    point = JointTrajectoryPoint()
    # The rolls above are the left arm's, as the SRDF writes its states; the right one mirrors.
    for side, mirror in (("left", 1.0), ("right", -1.0)):
        for joint, value in POSTURES[name].items():
            goal.trajectory.joint_names.append(f"{side}_{joint}")
            point.positions.append(mirror * value if joint.endswith("roll_joint") else value)
    # Not int(seconds): a truncated fraction is an arm moving faster than this file says.
    point.time_from_start = Duration(seconds=POSTURE_DURATION_S).to_msg()
    goal.trajectory.points = [point]

    handle_future = client.send_goal_async(goal)
    rclpy.spin_until_future_complete(node, handle_future, timeout_sec=timeout_s)
    handle = handle_future.result() if handle_future.done() else None
    if handle is None or not handle.accepted:
        node.get_logger().warning(f"the arm controller refused the {name} posture")
        return False

    result_future = handle.get_result_async()
    rclpy.spin_until_future_complete(
        node, result_future, timeout_sec=POSTURE_DURATION_S + timeout_s
    )
    result = result_future.result() if result_future.done() else None
    if result is None or result.result.error_code != 0:
        node.get_logger().warning(f"the arms did not reach the {name} posture")
        return False
    return True


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--posture", choices=sorted(POSTURES), default="clear")
    parser.add_argument("--no-hands", action="store_true", help="leave the Dex3 hands alone")
    args = parser.parse_args(remove_ros_args(sys.argv if argv is None else argv)[1:])
    rclpy.init()
    node = Node("g1_bringup_activate_arm")
    try:
        component_client = node.create_client(
            SetHardwareComponentState, "/controller_manager/set_hardware_component_state"
        )
        controller_client = node.create_client(
            SwitchController, "/controller_manager/switch_controller"
        )

        # One switch, not two: see this script's module docstring.
        node.get_logger().info(f"activating controller {CONTROLLER_NAME}...")
        if not retry_switch(
            node,
            controller_client,
            [CONTROLLER_NAME],
            [ARM_FREEZE_CONTROLLER],
            COMPONENT_ACTIVATE_TIMEOUT_S,
        ):
            node.get_logger().error(f"failed to activate {CONTROLLER_NAME}")
            return 1

        for component, controller in () if args.no_hands else HANDS:
            node.get_logger().info(f"activating hand {component}...")
            if not set_component_state(
                node,
                component_client,
                component,
                State.PRIMARY_STATE_ACTIVE,
                "active",
                HAND_ACTIVATE_TIMEOUT_S,
            ) or not switch_controller(
                node, controller_client, [controller], [], SERVICE_CALL_TIMEOUT_S
            ):
                node.get_logger().warning(
                    f"{component} did not come up; the arm is still usable but this hand "
                    "will not move. Check that it is powered and publishing state."
                )

        if args.posture == "sides":
            node.get_logger().info("hanging the arms at the sides, out of the cameras' view...")
            if not move_arms(node, "sides"):
                node.get_logger().error("the arms still hang where the cameras see them")
                return 1
            node.get_logger().info("the arms hang at the sides.")
            return 0

        node.get_logger().info("moving the arms clear of whatever is in front of the robot...")
        if not move_arms(node, "clear"):
            # The arm is acquired and usable by hand, but still inside the octomap, so every
            # planned motion after this is refused at its start state.
            node.get_logger().error(
                "the arms are still where they hang; MoveIt will refuse to plan from there. "
                "Move them clear before asking for a skill."
            )
            return 1
        node.get_logger().info("the arms are clear and a planner can work from here.")

        node.get_logger().info("activation complete: the arm and both hands are acquired.")
        return 0
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    sys.exit(main())
