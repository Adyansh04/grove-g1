#!/usr/bin/env python3
"""Releases control authority over the G1 arm bridge, in the mandatory order.

Reverse of activate_arm: deactivates arm_trajectory_controller *before*
G1ArmSdkSystem, so an active controller never claims interfaces out from
under a deactivating component. The component's own on_deactivate runs its
ramp-down synchronously and blocks the service call for roughly
blend_ramp_down_s -- that's by design (see g1_hardware_interface's README),
not a timeout to work around, so this script's service-call timeout is set
comfortably longer than the configured ramp.

Python for the same reason as activate_arm: one-shot administrative
sequencing, not a control loop.
"""

import sys

import rclpy
from controller_manager_msgs.srv import SetHardwareComponentState, SwitchController
from lifecycle_msgs.msg import State
from rclpy.node import Node

COMPONENT_NAME = "G1ArmSdkSystem"
CONTROLLER_NAME = "arm_trajectory_controller"
SERVICE_CALL_TIMEOUT_S = 5.0

# Must comfortably exceed blend_ramp_down_s (2.0 s default): on_deactivate
# blocks the whole service call for the ramp's duration by design (see
# g1_hardware_interface's README -- resource_manager serializes lifecycle
# transitions against read()/write(), so the ramp-down runs synchronously
# inside this call).
COMPONENT_DEACTIVATE_TIMEOUT_S = 10.0


def switch_controller(node, client, activate, deactivate, timeout_s):
    if not client.wait_for_service(timeout_sec=timeout_s):
        node.get_logger().error("switch_controller service not available")
        return False

    request = SwitchController.Request()
    request.activate_controllers = activate
    request.deactivate_controllers = deactivate
    request.strictness = SwitchController.Request.STRICT
    request.activate_asap = True
    request.timeout.sec = int(timeout_s)

    future = client.call_async(request)
    rclpy.spin_until_future_complete(node, future, timeout_sec=timeout_s + 1.0)
    result = future.result() if future.done() else None
    return result is not None and result.ok


def set_component_state(node, client, target_state_id, target_label, timeout_s):
    if not client.wait_for_service(timeout_sec=5.0):
        node.get_logger().error("set_hardware_component_state service not available")
        return False

    request = SetHardwareComponentState.Request()
    request.name = COMPONENT_NAME
    request.target_state.id = target_state_id
    request.target_state.label = target_label

    future = client.call_async(request)
    rclpy.spin_until_future_complete(node, future, timeout_sec=timeout_s)
    result = future.result() if future.done() else None
    return result is not None and result.ok


def main():
    rclpy.init()
    node = Node("g1_bringup_deactivate_arm")
    try:
        controller_client = node.create_client(
            SwitchController, "/controller_manager/switch_controller"
        )
        component_client = node.create_client(
            SetHardwareComponentState, "/controller_manager/set_hardware_component_state"
        )

        # Controller-then-component: see this script's module docstring.
        node.get_logger().info(f"deactivating controller {CONTROLLER_NAME}...")
        if not switch_controller(
            node, controller_client, [], [CONTROLLER_NAME], SERVICE_CALL_TIMEOUT_S
        ):
            node.get_logger().error(f"failed to deactivate {CONTROLLER_NAME}")
            return 1

        node.get_logger().info(
            f"deactivating hardware component {COMPONENT_NAME} "
            "(blocks for the ramp-down by design)..."
        )
        if not set_component_state(
            node,
            component_client,
            State.PRIMARY_STATE_INACTIVE,
            "inactive",
            COMPONENT_DEACTIVATE_TIMEOUT_S,
        ):
            node.get_logger().error(f"failed to deactivate {COMPONENT_NAME}")
            return 1

        node.get_logger().info("deactivation complete: controller and component both inactive.")
        return 0
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    sys.exit(main())
