#!/usr/bin/env python3
"""Picks each object in turn, sets it back down where it stood, and scores every grasp.

For tuning grasps in simulation. Run it against a stack whose simulator logs its contact monitor
(`contact_log:=<file>` on bringup.launch.py) and pass the same file: each pick is scored by what the
hand struck on the way (peak force on the table, on the robot and on the other objects), how
centred its grip sat, and whether the object came up. The joints and the objects are saved when the
hand has closed and after the lift, for g1_bringup's tools/render_grasp.py to draw.

    ros2 run g1_manipulation grasp_eval --contact-log /root/data/grasp-eval/contacts.jsonl \\
        --out /root/data/grasp-eval/run1 [--objects red_cube green_can]

Python because it sequences actions and writes files, well under 1 Hz.
"""

from __future__ import annotations

import argparse
import json
import math
import pathlib
import sys
import time

import rclpy
import tf2_geometry_msgs  # noqa: F401  (registers PoseStamped with tf2)
from geometry_msgs.msg import PoseStamped
from rclpy.action import ActionClient
from rclpy.duration import Duration
from rclpy.node import Node
from rclpy.time import Time
from rclpy.utilities import remove_ros_args
from sensor_msgs.msg import JointState
from tf2_ros import Buffer, TransformListener
from vision_msgs.msg import Detection3DArray

from g1_msgs.action import Pick, Place

OBJECTS_TOPIC = "/g1_sensor_relay/object_poses"
# The pelvis is pinned in the evaluation world, so poses in its frame stay put and the render can
# rebuild the scene from them.
FRAME = "pelvis"
PICK_TIMEOUT_S = 240.0
PLACE_TIMEOUT_S = 180.0
# m. An object counts as lifted once it rose this far.
LIFTED_M = 0.03
# m. Another object counts as moved once it shifted this far.
MOVED_M = 0.01
# N. Contact with the table or the robot: up to the first is a touch, past the second a strike.
TOUCH_N = 2.0
STRIKE_N = 5.0


class Evaluator(Node):
    """Holds the latest joints and object poses, and runs one pick and place at a time."""

    def __init__(self) -> None:
        super().__init__("grasp_eval")
        self.joints: dict[str, float] = {}
        self.objects: dict[str, dict] = {}
        self.tf = Buffer()
        self.listener = TransformListener(self.tf, self)
        self.create_subscription(JointState, "/joint_states", self._joints, 10)
        self.create_subscription(Detection3DArray, OBJECTS_TOPIC, self._objects, 10)
        self.pick = ActionClient(self, Pick, "/g1_manipulation_server/pick")
        self.place = ActionClient(self, Place, "/g1_manipulation_server/place")
        self.phase = ""

    def _joints(self, msg: JointState) -> None:
        self.joints.update(zip(msg.name, msg.position, strict=False))

    def _objects(self, msg: Detection3DArray) -> None:
        for detection in msg.detections:
            pose = PoseStamped()
            pose.header = detection.header
            pose.header.stamp = Time().to_msg()  # the latest transform; the pelvis is pinned
            pose.pose = detection.results[0].pose.pose
            try:
                local = self.tf.transform(pose, FRAME, timeout=Duration(seconds=0.2))
            except Exception:  # noqa: BLE001  TF not up yet: the next message retries
                continue
            p, q = local.pose.position, local.pose.orientation
            self.objects[detection.id] = {
                "pos": [p.x, p.y, p.z],
                "quat": [q.w, q.x, q.y, q.z],
                "size": [detection.bbox.size.x, detection.bbox.size.y, detection.bbox.size.z],
            }

    def spin_for(self, seconds: float) -> None:
        end = time.monotonic() + seconds
        while time.monotonic() < end:
            rclpy.spin_once(self, timeout_sec=0.05)

    def snapshot(
        self, path: pathlib.Path, target: str, side: str, phase: str, settle: bool = True
    ) -> None:
        """Writes the joints and objects; from inside a callback, without spinning first."""
        if settle:
            self.spin_for(0.5)
        path.write_text(
            json.dumps(
                {
                    "object": target,
                    "side": side,
                    "phase": phase,
                    "frame": FRAME,
                    "joints": self.joints,
                    "objects": self.objects,
                },
                indent=1,
            )
        )

    def run_action(self, client: ActionClient, goal, timeout_s: float, on_phase=None):
        if not client.wait_for_server(timeout_sec=10.0):
            return None
        self.phase = ""

        def feedback(msg):
            if msg.feedback.phase != self.phase:
                self.phase = msg.feedback.phase
                if on_phase is not None:
                    on_phase(self.phase)

        future = client.send_goal_async(goal, feedback_callback=feedback)
        rclpy.spin_until_future_complete(self, future, timeout_sec=10.0)
        handle = future.result()
        if handle is None or not handle.accepted:
            return None
        result = handle.get_result_async()
        rclpy.spin_until_future_complete(self, result, timeout_sec=timeout_s)
        return result.result().result if result.done() else None


def read_events(path: pathlib.Path, offset: int) -> tuple[list[dict], int]:
    """The contact monitor's lines written since @p offset, and the new offset."""
    if not path.is_file():
        return [], offset
    with path.open() as handle:
        handle.seek(offset)
        lines = handle.readlines()
        offset = handle.tell()
    return [json.loads(line) for line in lines if line.strip()], offset


def score(target: str, events: list[dict]) -> dict:
    """Sums one pick and place's contact events."""
    out = {"table_peak_n": 0.0, "table_links": set(), "robot_peak_n": 0.0, "others": {}}
    grasp = next((e for e in events if e["event"] == "grasp" and e["object"] == target), None)
    for event in events:
        if event["event"] != "contact":
            continue
        kind, peak = event["other_kind"], event["peak_n"]
        if kind == "environment":
            out["table_peak_n"] = max(out["table_peak_n"], peak)
            out["table_links"].add(event["link"])
        elif kind == "robot":
            out["robot_peak_n"] = max(out["robot_peak_n"], peak)
        elif kind == "prop" and event["other"] != target:
            out["others"][event["other"]] = max(out["others"].get(event["other"], 0.0), peak)
    out["table_links"] = sorted(out["table_links"])
    out["grasp"] = grasp
    return out


def verdict(row: dict) -> str:
    if row["table_peak_n"] > STRIKE_N or row["robot_peak_n"] > STRIKE_N:
        return "STRIKE"
    if not row["lifted"]:
        return "MISS"
    if row["table_peak_n"] > TOUCH_N or row["moved_others"]:
        return "ROUGH"
    return "OK"


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--contact-log", type=pathlib.Path, required=True)
    parser.add_argument("--out", type=pathlib.Path, required=True)
    parser.add_argument("--objects", nargs="*", default=[], help="default: every object reported")
    parser.add_argument("--no-place", action="store_true", help="drop the object instead")
    parser.add_argument(
        "--pick-suffix",
        default="",
        help="appended to an object's name for the pick, such as _0 for perception's instances",
    )
    args = parser.parse_args(remove_ros_args(sys.argv if argv is None else argv)[1:])
    (args.out / "snapshots").mkdir(parents=True, exist_ok=True)

    rclpy.init()
    node = Evaluator()
    rows = []
    try:
        node.spin_for(3.0)
        names = args.objects or sorted(node.objects)
        offset = args.contact_log.stat().st_size if args.contact_log.is_file() else 0
        for name in names:
            if name not in node.objects:
                node.get_logger().error(f"{name} is not on {OBJECTS_TOPIC}")
                continue
            before = {k: list(v["pos"]) for k, v in node.objects.items()}
            start = node.objects[name]
            side = "left" if start["pos"][1] > 0.0 else "right"
            node.get_logger().info(f"picking {name} with the {side} hand")
            snapshots = args.out / "snapshots"

            def on_phase(phase, name=name, side=side, snapshots=snapshots):
                if phase == Pick.Feedback.PHASE_LIFT:
                    node.snapshot(
                        snapshots / f"{name}_closed.json", name, side, "closed", settle=False
                    )

            goal = Pick.Goal(object_id=name + args.pick_suffix, arm=side)
            began = time.monotonic()
            picked = node.run_action(node.pick, goal, PICK_TIMEOUT_S, on_phase)
            node.snapshot(snapshots / f"{name}_lifted.json", name, side, "lifted")
            lifted = node.objects[name]["pos"][2] - start["pos"][2] > LIFTED_M
            placed = None
            if picked is not None and picked.success and not args.no_place:
                pose = PoseStamped()
                pose.header.frame_id = FRAME
                pose.pose.position.x, pose.pose.position.y, pose.pose.position.z = start["pos"]
                (
                    pose.pose.orientation.w,
                    pose.pose.orientation.x,
                    pose.pose.orientation.y,
                    pose.pose.orientation.z,
                ) = start["quat"]
                placed = node.run_action(
                    node.place, Place.Goal(pose=pose, arm=side), PLACE_TIMEOUT_S
                )
            node.spin_for(1.0)
            events, offset = read_events(args.contact_log, offset)
            row = score(name, events)
            row.update(
                object=name,
                side=side,
                picked=bool(picked and picked.success),
                pick_message=picked.message if picked else "no answer",
                lifted=bool(lifted),
                placed=bool(placed and placed.success),
                seconds=round(time.monotonic() - began, 1),
                moved_others=[
                    other
                    for other, pos in before.items()
                    if other != name
                    and other in node.objects
                    and math.dist(pos, node.objects[other]["pos"]) > MOVED_M
                ],
            )
            row["verdict"] = verdict(row)
            rows.append(row)
            node.get_logger().info(
                f"{name}: {row['verdict']}, table {row['table_peak_n']:.1f} N, grip offset "
                f"{row['grasp']['offset_mm'] if row['grasp'] else '-'} mm"
            )
    finally:
        (args.out / "results.json").write_text(json.dumps(rows, indent=1, default=list))
        lines = [
            "| object | hand | verdict | lifted | placed | table peak N | table links "
            "| robot peak N | grip offset mm | digits | others hit | others moved |",
            "|---|---|---|---|---|---|---|---|---|---|---|---|",
        ]
        for r in rows:
            g = r["grasp"] or {}
            lines.append(
                f"| {r['object']} | {r['side']} | {r['verdict']} | {r['lifted']} | {r['placed']} "
                f"| {r['table_peak_n']:.1f} | {', '.join(r['table_links'])} | "
                f"{r['robot_peak_n']:.1f} | {g.get('offset_mm', '-')} | "
                f"{', '.join(g.get('digits', []))} | {r['others']} | {r['moved_others']} |"
            )
        (args.out / "results.md").write_text("\n".join(lines) + "\n")
        print("\n".join(lines))
        node.destroy_node()
        rclpy.try_shutdown()
    return 0


if __name__ == "__main__":
    sys.exit(main())
