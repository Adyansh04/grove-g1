<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_manipulation</name>
  <version>0.1.0</version>
  <description>
    Pick and place skills for the G1, served as actions over MoveIt, plus the
    object-pose source that decides where object poses may come from.
  </description>
  <maintainer email="gupta.adyansh@gmail.com">Adyansh</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>g1_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- Launch-time only: manipulation.launch.py builds its MoveIt parameters from it. -->
  <exec_depend>g1_description</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>g1_moveit_config</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- ament_lint_common intentionally not used to avoid clang-format conflicts. -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>tf2_ros</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_cmake_gmock</test_depend>
  <!-- Repeated for the launch tests' Python imports: their environment is built from test
       dependencies, and a plain <depend> does not put these on it. -->
  <test_depend>g1_msgs</test_depend>
  <test_depend>vision_msgs</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
