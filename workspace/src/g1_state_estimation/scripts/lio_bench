#!/usr/bin/env python3
"""Measure FAST-LIO against ground truth with NOTHING else in the loop.

No Nav2, no AMCL, no map, no costmap. Just the simulator, the LIO pipeline, and velocity
commands driven open-loop from here. Everything the earlier runs blamed on LIO could equally
have been the planner, the controller or a stale map; this removes all of them.

Drives an open-loop square and reports the two trajectories side by side:
  truth  /sportmodestate            -- exact MuJoCo pelvis state
  lio    odom -> base_footprint     -- what the LIO pipeline publishes
The odom frame is latched at start with yaw zeroed, so the comparison is done under the single
best-fit rotation between the paths. What survives that is real drift.
"""
import csv
import math, os, signal, sys, time
import rclpy
from geometry_msgs.msg import Twist
from rclpy.action import ActionClient
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from tf2_msgs.msg import TFMessage
from unitree_go.msg import SportModeState
from g1_msgs.action import SetLocoMode

# Below these the sim walking policy does not step at all (measured, see g1_locomotion).
VX, WZ = 0.5, 1.6
# An arbitrary wander, not a figure. Comparing two estimates OF THE SAME MOTION does not
# care what shape that motion is, so there is no controller here and nothing to tune -- the
# gait just has to move the robot and turn it now and then. Three attempts at steering this
# policy produced three different bugs; none of them made the comparison any more valid.
# (vx, wz, seconds)
LEGS = [(VX, 0.0, 8.0), (0.0, WZ, 1.0), (VX, 0.0, 6.0), (0.0, -WZ, 1.4),
        (VX, 0.0, 7.0), (0.0, WZ, 1.2), (VX, 0.0, 5.0), (0.0, -WZ, 1.0),
        (VX, 0.0, 8.0), (0.0, WZ, 1.6), (VX, 0.0, 6.0)]
# Where the full paired trace lands, for plotting the two paths against each other.
TRACE_PATH = os.environ.get("LIO_BENCH_TRACE", "/tmp/lio_bench_trace.csv")
# How far along the path between printed rows. Distance rather than time, so a slow leg and a
# fast one get the same number of samples and the table reads as geometry, not as a clock.
TRACE_EVERY_M = 1.0


class Bench(Node):
    def __init__(s):
        super().__init__("lio_bench")
        s.truth = s.lio = s.yaw = None
        s.track = []
        s.create_subscription(TFMessage, "/tf", s._tf, 100)
        s.create_subscription(SportModeState, "/sportmodestate", s._gt, qos_profile_sensor_data)
        s.cmd = s.create_publisher(Twist, "/g1_loco_bridge/cmd_vel", 1)

    def _tf(s, m):
        for t in m.transforms:
            if t.header.frame_id == "odom" and t.child_frame_id == "base_footprint":
                s.lio = (t.transform.translation.x, t.transform.translation.y)

    def _gt(s, m):
        s.truth = (m.position[0], m.position[1])
        # imu_state.rpy[2] is the pelvis heading in the world frame -- ground truth, so the
        # steering below never depends on the estimate being measured.
        s.yaw = m.imu_state.rpy[2]

    def spin(s, secs, twist=None):
        end = time.time() + secs
        while time.time() < end and rclpy.ok():
            if twist is not None:
                s.cmd.publish(twist)
            rclpy.spin_once(s, timeout_sec=0.02)
            if s.truth is not None and s.lio is not None:
                s.track.append((s.truth, s.lio))

    def wait_for(s, pred, secs, why):
        end = time.time() + secs
        while time.time() < end and rclpy.ok():
            rclpy.spin_once(s, timeout_sec=0.05)
            if pred():
                return True
        print("RESULT ABORT: " + why)
        return False

    def set_mode(s, fsm):
        c = ActionClient(s, SetLocoMode, "/g1_loco_bridge/set_mode")
        if not c.wait_for_server(timeout_sec=30.0):
            print("RESULT ABORT: no set_mode server")
            return False
        g = SetLocoMode.Goal(); g.fsm_id = fsm
        f = c.send_goal_async(g); rclpy.spin_until_future_complete(s, f, timeout_sec=20.0)
        h = f.result()
        if h is None or not h.accepted:
            print("RESULT ABORT: SetLocoMode(%d) rejected" % fsm)
            return False
        r = h.get_result_async(); rclpy.spin_until_future_complete(s, r, timeout_sec=30.0)
        c.destroy()
        return True


def report(b):
    if len(b.track) < 50:
        print("RESULT too few paired samples: %d" % len(b.track))
        return
    (t0, l0) = b.track[0]
    T = [(a[0]-t0[0], a[1]-t0[1]) for a, _ in b.track]
    L = [(c[0]-l0[0], c[1]-l0[1]) for _, c in b.track]
    dist = sum(math.dist(b.track[i][0], b.track[i-1][0]) for i in range(1, len(b.track)))
    num = sum(tx*ly - ty*lx for (tx,ty),(lx,ly) in zip(T, L))
    den = sum(tx*lx + ty*ly for (tx,ty),(lx,ly) in zip(T, L))
    th = math.atan2(num, den); c, s_ = math.cos(th), math.sin(th)
    gaps = [math.hypot(tx-(c*lx-s_*ly), ty-(s_*lx+c*ly)) for (tx,ty),(lx,ly) in zip(T, L)]
    # Full paired trace, aligned into the truth frame so the two columns are directly
    # comparable. Written before the summary so it survives even if something below throws.
    try:
        with open(TRACE_PATH, "w", newline="") as fh:
            w = csv.writer(fh)
            w.writerow(["i", "truth_x", "truth_y", "lio_x", "lio_y", "gap_m", "path_m"])
            run = 0.0
            for i, ((tx, ty), (lx, ly)) in enumerate(zip(T, L)):
                if i:
                    run += math.dist(T[i], T[i-1])
                ax, ay = c*lx - s_*ly, s_*lx + c*ly
                w.writerow(["%d" % i, "%.4f" % tx, "%.4f" % ty, "%.4f" % ax, "%.4f" % ay,
                            "%.4f" % math.hypot(tx-ax, ty-ay), "%.4f" % run])
        print("RESULT trace              %s (%d rows)" % (TRACE_PATH, len(T)))
    except OSError as e:
        print("RESULT trace              could not write %s: %s" % (TRACE_PATH, e))

    # Sampled every metre of travel, so divergence is visible as it develops rather than only
    # at the end -- a loop can finish close by luck after wandering badly in the middle.
    print("RESULT --- path, every %.1f m of travel ---" % TRACE_EVERY_M)
    print("RESULT   path_m |    truth (x, y)  |      lio (x, y)  |   gap")
    run = 0.0
    nxt = 0.0
    for i, ((tx, ty), (lx, ly)) in enumerate(zip(T, L)):
        if i:
            run += math.dist(T[i], T[i-1])
        if run + 1e-9 >= nxt:
            ax, ay = c*lx - s_*ly, s_*lx + c*ly
            print("RESULT   %6.2f | (%+6.2f, %+6.2f) | (%+6.2f, %+6.2f) | %5.3f m"
                  % (run, tx, ty, ax, ay, math.hypot(tx-ax, ty-ay)))
            nxt += TRACE_EVERY_M
    print("RESULT samples            %d" % len(b.track))
    print("RESULT path travelled     %.2f m (truth)" % dist)
    print("RESULT truth  end         (%+.2f, %+.2f) m from start" % T[-1])
    print("RESULT lio    end         (%+.2f, %+.2f) m from start (aligned %+.1f deg)"
          % (c*L[-1][0]-s_*L[-1][1], s_*L[-1][0]+c*L[-1][1], math.degrees(th)))
    print("RESULT xy drift           final=%.3f m  max=%.3f m" % (gaps[-1], max(gaps)))
    if dist > 0.5:
        print("RESULT drift over path    %.2f%%" % (100*gaps[-1]/dist))


def main():
    rclpy.init(); b = Bench()

    def stop(*_):
        b.cmd.publish(Twist()); report(b); sys.stdout.flush(); rclpy.shutdown()
    signal.signal(signal.SIGINT, stop); signal.signal(signal.SIGTERM, stop)

    # TF appearing IS the readiness signal: it only exists once FAST-LIO has fixed gravity and
    # produced a pose the publisher accepted.
    if not b.wait_for(lambda: b.lio is not None and b.truth is not None, 180.0,
                      "odom -> base_footprint never appeared"):
        report(b); rclpy.shutdown(); return

    if not (b.set_mode(4) and (time.sleep(3) or True) and b.set_mode(500)):
        report(b); rclpy.shutdown(); return
    b.spin(3.0)

    for i, (vx, wz, secs) in enumerate(LEGS):
        t = Twist(); t.linear.x = vx; t.angular.z = wz
        print("leg %d/%d: vx=%.1f wz=%+.1f for %.1fs" % (i + 1, len(LEGS), vx, wz, secs),
              flush=True)
        b.spin(secs, t)
        b.spin(1.0)
    b.cmd.publish(Twist())
    b.spin(2.0)
    report(b); sys.stdout.flush(); rclpy.shutdown()

main()
