<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>canopy_perception</name>
  <version>0.1.0</version>
  <description>
    The world model's perception front end: a detector and a describer that ask the host model
    servers, a mock detector that cuts masks from a simulator's ground truth, and the depth
    history that pairs a late mask with the frame it was cut from.
  </description>
  <maintainer email="gupta.adyansh@gmail.com">Adyansh</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Installs canopy_perception/, the module the scripts import. -->
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>canopy_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>vision_msgs</depend>

  <!-- For the scripts, which talk to the host model servers so torch stays out of the robot's
       image. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-zmq</exec_depend>
  <exec_depend>python3-msgpack</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <!-- msgpack-numpy has no rosdep key or Ubuntu package: pip install msgpack-numpy==0.4.8, or
       the scripts fail on import. -->
  <exec_depend>python3-pip</exec_depend>

  <!-- ament_lint_common intentionally not used to avoid clang-format conflicts. -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
