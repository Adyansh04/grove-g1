<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>canopy</name>
  <version>0.1.0</version>
  <description>
    What a robot knows about its surroundings on top of the SLAM map: rooms and doorways
    segmented from the occupancy grid, objects fused from detector masks and depth, and how much
    of each room its cameras have seen. Plans the viewpoints that finish the job, and answers
    where-is and how-to-get-there queries.
  </description>
  <maintainer email="gupta.adyansh@gmail.com">Adyansh</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>eigen</depend>
  <depend>canopy_msgs</depend>
  <depend>canopy_perception</depend>
  <depend>geometry_msgs</depend>
  <depend>libopencv-dev</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>yaml-cpp</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- The run tools in scripts/. -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>

  <!-- ament_lint_common intentionally not used to avoid clang-format conflicts. -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
