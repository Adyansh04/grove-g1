<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="g1_29dof_with_hand_rev_1_0">

  <!-- The body, the frames and both hands. Shared with g1_lowcmd.urdf.xacro so a grasp frame or
       a sensor extrinsic cannot drift between the two stacks. -->
  <xacro:include filename="g1_common.xacro"/>

  <!-- Load tunable YAML for ROS 2 control parameters. -->
  <xacro:property name="arm_sdk_params" value="${xacro.load_yaml('../config/arm_sdk_params.yaml')}"/>

  <xacro:macro name="g1_arm_joint" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <param name="motor_index">${arm_sdk_params.joints[name].motor_index}</param>
      <param name="kp">${arm_sdk_params.joints[name].kp}</param>
      <param name="kd">${arm_sdk_params.joints[name].kd}</param>
    </joint>
  </xacro:macro>

  <!-- The 14 arm joints. The component also holds the 3 waist motors /arm_sdk hands over with
       them, but they are not declared here: nothing plans them, so they need neither a command
       interface nor a controller. Legs and hands stay with the onboard controller. -->
  <ros2_control name="G1ArmSdkSystem" type="system">
    <hardware>
      <plugin>g1_hardware_interface/G1ArmSdkSystem</plugin>
      <param name="command_publish_rate">${arm_sdk_params.system.command_publish_rate}</param>
      <param name="blend_ramp_up_s">${arm_sdk_params.system.blend_ramp_up_s}</param>
      <param name="blend_ramp_down_s">${arm_sdk_params.system.blend_ramp_down_s}</param>
      <param name="emergency_ramp_down_s">${arm_sdk_params.system.emergency_ramp_down_s}</param>
      <param name="max_joint_velocity_rad_s">${arm_sdk_params.system.max_joint_velocity_rad_s}</param>
      <param name="lowstate_timeout_ms">${arm_sdk_params.system.lowstate_timeout_ms}</param>
      <param name="waist_kp">${arm_sdk_params.system.waist_kp}</param>
      <param name="waist_kd">${arm_sdk_params.system.waist_kd}</param>
    </hardware>

    <xacro:g1_arm_joint name="left_shoulder_pitch_joint"/>
    <xacro:g1_arm_joint name="left_shoulder_roll_joint"/>
    <xacro:g1_arm_joint name="left_shoulder_yaw_joint"/>
    <xacro:g1_arm_joint name="left_elbow_joint"/>
    <xacro:g1_arm_joint name="left_wrist_roll_joint"/>
    <xacro:g1_arm_joint name="left_wrist_pitch_joint"/>
    <xacro:g1_arm_joint name="left_wrist_yaw_joint"/>
    <xacro:g1_arm_joint name="right_shoulder_pitch_joint"/>
    <xacro:g1_arm_joint name="right_shoulder_roll_joint"/>
    <xacro:g1_arm_joint name="right_shoulder_yaw_joint"/>
    <xacro:g1_arm_joint name="right_elbow_joint"/>
    <xacro:g1_arm_joint name="right_wrist_roll_joint"/>
    <xacro:g1_arm_joint name="right_wrist_pitch_joint"/>
    <xacro:g1_arm_joint name="right_wrist_yaw_joint"/>
  </ros2_control>

</robot>
