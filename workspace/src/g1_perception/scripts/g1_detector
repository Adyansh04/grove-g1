#!/usr/bin/env python3
"""Asks the host vision server what is in the camera image and publishes the masks it answers with.

Python because it is a ZMQ and msgpack client; see the package README.

`phrases` is the whole control interface: an empty list is idle, and

    ros2 param set /g1_detector phrases "['red cube', 'blue sphere']"

is what the instruction grounder writes too.
"""

import numpy as np
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import Image

from g1_msgs.msg import InstanceMask, InstanceMaskArray
from g1_perception.host_clients import VisionClient, image_to_array

# Reliable, not sensor QoS: masks are 13 kB at under a hertz and a dropped one is seconds blind.
MASK_QOS = 2


class Detector(Node):
    def __init__(self):
        super().__init__("g1_detector", automatically_declare_parameters_from_overrides=True)
        self._address = self._param("server_address", "tcp://127.0.0.1:5560")
        self._max_image_age_s = float(self._param("max_image_age_s", 1.0))
        self._box_threshold = float(self._param("box_threshold", 0.30))
        self._text_threshold = float(self._param("text_threshold", 0.25))
        rate_hz = float(self._param("detect_rate_hz", 1.0))
        if not self.has_parameter("phrases"):
            # Typed, not inferred: rclpy reads a bare [] as BYTE_ARRAY, and Jazzy then refuses
            # every STRING_ARRAY written to it.
            self.declare_parameter("phrases", rclpy.Parameter.Type.STRING_ARRAY)

        self._image = None
        self._publisher = self.create_publisher(InstanceMaskArray, "~/instance_masks", MASK_QOS)
        # Sensor QoS deliberately: the relay publishes best-effort, and a reliable subscriber
        # against it silently never matches.
        self.create_subscription(Image, "color/image_raw", self._on_image, qos_profile_sensor_data)

        self._client = VisionClient(self._address, int(self._param("zmq_timeout_ms", 20000)))
        self._ready = self._handshake()
        self.create_timer(1.0 / max(rate_hz, 0.01), self._tick)

    def _param(self, name, default):
        return self.get_parameter_or(name, rclpy.parameter.Parameter(name, value=default)).value

    def _handshake(self):
        try:
            reply = self._client.call("ping")
        except RuntimeError as error:
            self.get_logger().warning(
                f"the vision server at {self._address} did not answer: {error}. "
                "Retrying on each detection; start it with scripts/vision_server.py."
            )
            return False
        self.get_logger().info(
            f"vision server at {self._address}: {reply.get('backend')} on {reply.get('device')}"
        )
        return True

    def _on_image(self, msg):
        self._image = msg

    def _phrases(self):
        # get_parameter_or, because a type-only declaration leaves the parameter uninitialized
        # until something writes it, and get_parameter raises on that.
        return [str(phrase) for phrase in self._param("phrases", []) or [] if str(phrase).strip()]

    def _tick(self):
        phrases = self._phrases()
        image = self._image
        if not phrases or image is None:
            return
        age = (self.get_clock().now() - rclpy.time.Time.from_msg(image.header.stamp)).nanoseconds / 1e9
        if age > self._max_image_age_s:
            self.get_logger().warning(
                f"the newest camera frame is {age:.1f} s old; not asking about it", throttle_duration_sec=5.0
            )
            return

        try:
            reply = self._client.call(
                "segment",
                {
                    "image": image_to_array(image),
                    "phrases": phrases,
                    "box_threshold": self._box_threshold,
                    "text_threshold": self._text_threshold,
                },
            )
        except (RuntimeError, ValueError) as error:
            self.get_logger().warning(str(error), throttle_duration_sec=5.0)
            return
        self._ready = True
        self._publish(image, reply)

    def close(self):
        self._client.close()

    def _publish(self, image, reply):
        masks = InstanceMaskArray()
        # The image's own header: the geometry node pairs on this stamp to find the depth frame
        # these masks were cut from, which is not the newest one by the time they arrive.
        masks.header = image.header
        masks.image_width = image.width
        masks.image_height = image.height
        masks.model = str(reply.get("model", ""))
        for instance in reply.get("instances", []):
            mask = np.asarray(instance["mask"], dtype=np.uint8)
            x, y, width, height = (int(value) for value in instance["roi"])
            if mask.shape != (height, width):
                self.get_logger().warning(
                    f"instance '{instance.get('label')}' has a {mask.shape} mask for a "
                    f"{height}x{width} region; dropping it"
                )
                continue
            out = InstanceMask()
            out.label = str(instance["label"])
            out.score = float(instance["score"])
            out.roi.x_offset = x
            out.roi.y_offset = y
            out.roi.width = width
            out.roi.height = height
            out.data = mask.reshape(-1).tolist()
            masks.instances.append(out)
        self._publisher.publish(masks)


def main():
    rclpy.init()
    node = Detector()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.close()
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
