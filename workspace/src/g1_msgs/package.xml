<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_msgs</name>
  <version>0.1.0</version>
  <description>
    Interfaces for the G1 LocoClient bridge (g1_locomotion): the SetLocoMode
    action and the LocoStatus message. See README for why SetLocoMode is an
    action rather than a service.
  </description>
  <maintainer email="gupta.adyansh@gmail.com">Adyansh</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- ament_lint_common is intentionally not used (see g1_description's and
       g1_hardware_interface's package.xml for the rationale): it drags in
       ament_uncrustify/ament_copyright, which conflict with this repo's root
       .clang-format and no-header-comment convention. -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
