# Put down whatever the given arm is holding.
#
# The target is where the object ends up, not where the palm goes: only the server knows how the
# object is held. It is transformed into the planning frame on arrival, so an odom goal survives
# the robot walking.

# Place on top of this detected surface, ignoring `pose`. Preferred: /objects is in odom, the
# frame the base approach parked against, and map drifts from odom by more than the arm's window.
string surface_object_id

# Where the object should end up, used only when surface_object_id is empty.
geometry_msgs/PoseStamped pose
string ARM_LEFT=left
string ARM_RIGHT=right
string arm
---
bool success
string message
---
string PHASE_PREPLACE=preplace
string PHASE_LOWER=lower
string PHASE_RELEASE=release
string PHASE_RETREAT=retreat
string phase
