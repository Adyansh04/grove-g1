<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_locomotion</name>
  <version>0.1.0</version>
  <description>
    LocoClient bridge for the Unitree G1: async request/response correlation, a velocity
    re-issue/authority state machine, and the lifecycle node that ties them to
    /api/sport/request and /api/sport/response. See README for the safety/authority model.
  </description>
  <maintainer email="gupta.adyansh@gmail.com">Adyansh</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>lifecycle_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>unitree_api</depend>
  <depend>g1_msgs</depend>
  <!-- nlohmann_json is the CMake config-package name (find_package(nlohmann_json REQUIRED) in
       CMakeLists.txt); nlohmann-json-dev is the actual rosdep/apt key that resolves to. -->
  <depend>nlohmann-json-dev</depend>

  <!-- ament_lint_common is intentionally not used (see g1_hardware_interface's package.xml for
       the rationale): it drags in ament_uncrustify/ament_copyright, which conflict with this
       repo's root .clang-format and no-header-comment convention. clang-format itself runs as a
       plain CTest against that same config (see CMakeLists.txt). -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_cmake_gmock</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
