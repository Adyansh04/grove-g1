# Environment variables for docker-compose
# Copy this file to .env and modify as needed:
#   cp .env.example .env

# Compose project name shown by `docker compose ps`
COMPOSE_PROJECT_NAME=grove-g1

# ROS distribution. The stack requires jazzy.
ROS_DISTRO=jazzy

# The dev image CI publishes from .devcontainer/Dockerfile (its base is pinned there). manage.sh
# picks the tag; set this only to use an image of your own.
# DEV_IMAGE_REPO=ghcr.io/adyansh04/grove-g1-dev

# Container naming prefix: <CONTAINER_PREFIX>_<ROS_DISTRO>
CONTAINER_PREFIX=ros_dev

# Display for GUI applications (usually inherited from host)
# DISPLAY=:0

# --- Pointing the container at a real G1 -------------------------------------
# Unset, these default to simulation: domain 1 and the loopback CycloneDDS profile, which keeps
# the simulator's rt/lowcmd off the LAN. g1_bringup's sim.launch.py refuses to start unless the
# profile pins 'lo', so the simulator cannot come up against a robot by accident.
#
# GROVE_G1_ROS_DOMAIN_ID=1
# GROVE_G1_CYCLONEDDS_URI=file:///etc/cyclonedds/cyclonedds.hardware.xml
# GROVE_G1_ROBOT_NIC=eth0
