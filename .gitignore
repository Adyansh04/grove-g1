# ROS 2 workspace build artifacts
workspace/build/
workspace/install/
workspace/log/

# workspace/.clang-format, .clang-tidy, .clangd and ruff.toml are NOT ignored any more.
# They used to be empty root-owned placeholders that Docker materialised for four
# single-file bind mounts, hence the ignore. Those mounts are gone; the paths are now
# committed relative symlinks to the repo-root configs, and the package CMakeLists resolve
# their lint configs through them (${CMAKE_CURRENT_SOURCE_DIR}/../../<config>).

# Keep source directory structure
!workspace/src/
!workspace/src/.gitkeep

# vcs-imported externals (see workspace.repos) — pulled in by `vcs import`,
# not tracked here. Listed explicitly per external repo rather than a broad
# workspace/src/* + !workspace/src/g1_* pattern: git prunes directories that
# match an ignore rule before it can evaluate a later negation on their
# contents, so the broad form silently drops g1_* packages too.
workspace/src/unitree_ros2/

# Environment files (keep .env.example)
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# IDE
.idea/
workspace/.vscode/
workspace/src/.vscode/

# Temporary files
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
