# Based on https://github.com/frankaemika/libfranka/blob/master/.clang-tidy
#
# Deviations from libfranka, all deliberate:
#  * bugprone-* and concurrency-* added -- this stack has a real-time write()
#    path, atomics and a lifecycle/executor thread split, which is exactly what
#    those two families cover.
#  * The identifier-naming options follow THIS codebase (lower_case data,
#    camelBack functions, k-prefixed constants) rather than libfranka's
#    camelBack data / bare-CamelCase constants. Adopting libfranka's verbatim
#    would demand renaming every member, parameter and constant here for no
#    functional gain, and would fight rclcpp's own snake_case convention.
#  * Checks that fire constantly on idiomatic ROS 2 are disabled below, each
#    with the reason inline.
#  * libfranka's '_(T|R|Tl|P|O|Pt)_' ignore regexes are dropped: they exempt
#    Franka's coordinate-frame names (O_T_EE etc.), which do not exist here.
Checks: '
  clang-diagnostic-*,
  clang-analyzer-*,
  -clang-analyzer-alpha*,
  google-*,
  -google-explicit-constructor,
  -google-runtime-references,
  -google-default-arguments,
  misc-*,
  -misc-throw-by-value-catch-by-reference,
  -misc-non-private-member-variables-in-classes,
  readability-*,
  -readability-redundant-string-init,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -modernize-pass-by-value,
  performance-*,
  -performance-no-automatic-move,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-type-member-init,
  -cppcoreguidelines-special-member-functions,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-avoid-magic-numbers
'
# -readability-magic-numbers / -cppcoreguidelines-avoid-magic-numbers: tuning
#   values already live in config/*.yaml per the repo convention; what is left
#   is test fixtures and motor-index arithmetic, where a literal is clearer.
# -cppcoreguidelines-pro-type-vararg: RCLCPP_* logging macros are variadic.
# -readability-function-cognitive-complexity: the metric counts macro
#   expansions, so RCLCPP_* logging and gtest EXPECT_* dominate the score
#   (on_init reads as 361, a linear validation function; each gtest TestBody
#   as 27-42). It measures macro density here, not code complexity.
# -bugprone-reserved-identifier: ROS 2's own include-guard convention, as
#   generated by `ros2 pkg create`, is PACKAGE__FILE_HPP_ -- the double
#   underscore is technically reserved but is the ecosystem standard.
# -bugprone-easily-swappable-parameters: assembleSimLowCmd() intentionally
#   takes parallel gain/target groups; splitting them into structs would hurt
#   the call site more than it helps.

# First-party headers only -- keeps vendored unitree_ros2 headers out.
HeaderFilterRegex: '^.*/g1_[a-z_]+/(include|src)/.*$'

CheckOptions:
  - key:    readability-identifier-naming.NamespaceCase
    value:  lower_case
  - key:    readability-identifier-naming.ClassCase
    value:  CamelCase
  - key:    readability-identifier-naming.StructCase
    value:  CamelCase
  - key:    readability-identifier-naming.EnumCase
    value:  CamelCase
  - key:    readability-identifier-naming.UnionCase
    value:  CamelCase
  - key:    readability-identifier-naming.TypedefCase
    value:  CamelCase
  - key:    readability-identifier-naming.FunctionCase
    value:  camelBack
  - key:    readability-identifier-naming.MethodCase
    value:  camelBack
  # Data is lower_case here (rclcpp's own convention), not libfranka's camelBack.
  - key:    readability-identifier-naming.ParameterCase
    value:  lower_case
  - key:    readability-identifier-naming.VariableCase
    value:  lower_case
  - key:    readability-identifier-naming.MemberCase
    value:  lower_case
  - key:    readability-identifier-naming.PublicMemberCase
    value:  lower_case
  - key:    readability-identifier-naming.ProtectedMemberCase
    value:  lower_case
  - key:    readability-identifier-naming.ProtectedMemberSuffix
    value:  '_'
  - key:    readability-identifier-naming.PrivateMemberCase
    value:  lower_case
  - key:    readability-identifier-naming.PrivateMemberSuffix
    value:  '_'
  - key:    readability-identifier-naming.LocalVariableCase
    value:  lower_case
  # Constants are k-prefixed CamelCase (kNumArmJoints, kWeightMotorIndex).
  - key:    readability-identifier-naming.ConstantCase
    value:  CamelCase
  - key:    readability-identifier-naming.ConstantPrefix
    value:  'k'
  - key:    readability-identifier-naming.ConstexprVariableCase
    value:  CamelCase
  - key:    readability-identifier-naming.ConstexprVariablePrefix
    value:  'k'
  - key:    readability-identifier-naming.GlobalConstantCase
    value:  CamelCase
  - key:    readability-identifier-naming.GlobalConstantPrefix
    value:  'k'
  - key:    readability-identifier-naming.EnumConstantCase
    value:  CamelCase
  - key:    readability-identifier-naming.EnumConstantPrefix
    value:  'k'
  # ...but a const local or const parameter is still ordinary data, not a
  # named constant, so it stays lower_case and unprefixed.
  - key:    readability-identifier-naming.LocalConstantCase
    value:  lower_case
  - key:    readability-identifier-naming.LocalConstantPrefix
    value:  ''
  - key:    readability-identifier-naming.ConstantParameterCase
    value:  lower_case
  - key:    readability-identifier-naming.ConstantParameterPrefix
    value:  ''
  - key:    readability-identifier-naming.ConstantMemberCase
    value:  lower_case
  - key:    readability-identifier-naming.ConstantMemberPrefix
    value:  ''
